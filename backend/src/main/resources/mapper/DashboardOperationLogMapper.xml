<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.DashboardOperationLogMapper">

    <resultMap id="BaseResultMap" type="com.art.entity.DashboardOperationLog">
        <id column="dash_log_id" property="dashLogId"/>
        <result column="op_type" property="opType"/>
        <result column="op_target" property="opTarget"/>
        <result column="op_detail" property="opDetail"/>
        <result column="op_result" property="opResult"/>
        <result column="op_user_id" property="opUserId"/>
        <result column="op_username" property="opUsername"/>
        <result column="op_role" property="opRole"/>
        <result column="op_time" property="opTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="dashLogId">
        INSERT INTO dashboard_operation_log
        (op_type, op_target, op_detail, op_result, op_user_id, op_username, op_role)
        VALUES
        (#{opType}, #{opTarget}, #{opDetail}, IFNULL(#{opResult}, 'SUCCESS'), #{opUserId}, #{opUsername}, #{opRole})
    </insert>

    <select id="selectRecent" resultMap="BaseResultMap">
        SELECT dash_log_id, op_type, op_target, op_detail, op_result, op_user_id, op_username, op_role, op_time
        FROM dashboard_operation_log
        ORDER BY dash_log_id DESC
        LIMIT #{limit}
    </select>

</mapper>
