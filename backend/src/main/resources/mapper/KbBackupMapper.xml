<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.KbBackupMapper">
    <resultMap id="BaseResultMap" type="com.art.entity.KbBackup">
        <id property="backupId" column="backup_id"/>
        <result property="backupName" column="backup_name"/>
        <result property="backupType" column="backup_type"/>
        <result property="tableScope" column="table_scope"/>
        <result property="itemCount" column="item_count"/>
        <result property="backupFile" column="backup_file"/>
        <result property="createdBy" column="created_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="backupId">
        INSERT INTO kb_backup(backup_name,backup_type,table_scope,item_count,backup_file,created_by,create_time)
        VALUES(#{backupName},#{backupType},#{tableScope},#{itemCount},#{backupFile},#{createdBy},#{createTime})
    </insert>

    <select id="selectAll" resultMap="BaseResultMap">SELECT * FROM kb_backup ORDER BY create_time DESC, backup_id DESC</select>

    <select id="selectById" resultMap="BaseResultMap">SELECT * FROM kb_backup WHERE backup_id=#{backupId}</select>
</mapper>
