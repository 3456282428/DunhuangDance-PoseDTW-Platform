<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.NewsMapper">
    <resultMap id="BaseResultMap" type="com.art.entity.News">
        <id property="newsId" column="news_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="publisher" column="publisher"/>
        <result property="publisherId" column="publisher_id"/>
        <result property="publishTime" column="publish_time"/>
        <result property="viewCount" column="view_count"/>
    </resultMap>
    <select id="selectById" resultMap="BaseResultMap">SELECT * FROM news WHERE news_id=#{newsId}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="newsId">INSERT INTO news(title,content,publisher,publisher_id,publish_time,view_count) VALUES(#{title},#{content},#{publisher},#{publisherId},#{publishTime},#{viewCount})</insert>
    <update id="update">UPDATE news SET title=#{title},content=#{content},publisher=#{publisher},publisher_id=#{publisherId},publish_time=#{publishTime},view_count=#{viewCount} WHERE news_id=#{newsId}</update>
    <delete id="deleteById">DELETE FROM news WHERE news_id=#{newsId}</delete>
    <select id="selectAll" resultMap="BaseResultMap">SELECT * FROM news ORDER BY publish_time DESC</select>
</mapper>
