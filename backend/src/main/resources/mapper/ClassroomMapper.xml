<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.ClassroomMapper">

    <resultMap id="BaseResultMap" type="com.art.entity.Classroom">
        <id property="classroomId" column="classroom_id"/>
        <result property="classroomName" column="classroom_name"/>
        <result property="capacity" column="capacity"/>
        <result property="roomType" column="room_type"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM classroom WHERE status = 1
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM classroom WHERE classroom_id = #{classroomId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="classroomId">
        INSERT INTO classroom (classroom_name, capacity, room_type, status)
        VALUES (#{classroomName}, #{capacity}, #{roomType}, #{status})
    </insert>

    <update id="update">
        UPDATE classroom
        SET classroom_name = #{classroomName},
            capacity = #{capacity},
            room_type = #{roomType},
            status = #{status}
        WHERE classroom_id = #{classroomId}
    </update>

    <delete id="deleteById">
        DELETE FROM classroom WHERE classroom_id = #{classroomId}
    </delete>
</mapper>