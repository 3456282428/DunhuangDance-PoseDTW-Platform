<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.CourseCategoryMapper">
    <resultMap id="BaseResultMap" type="com.art.entity.CourseCategory">
        <id property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="description" column="description"/>
    </resultMap>
    <select id="selectAll" resultMap="BaseResultMap">SELECT * FROM course_category</select>
    <select id="selectById" resultMap="BaseResultMap">SELECT * FROM course_category WHERE category_id=#{categoryId}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="categoryId">INSERT INTO course_category(category_name,description) VALUES(#{categoryName},#{description})</insert>
    <update id="update">UPDATE course_category SET category_name=#{categoryName},description=#{description} WHERE category_id=#{categoryId}</update>
    <delete id="deleteById">DELETE FROM course_category WHERE category_id=#{categoryId}</delete>
</mapper>