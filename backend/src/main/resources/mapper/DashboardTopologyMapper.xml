<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.DashboardTopologyMapper">

    <resultMap id="BaseResultMap" type="com.art.entity.DashboardTopology">
        <id column="edge_id" property="edgeId"/>
        <result column="source_type" property="sourceType"/>
        <result column="source_key" property="sourceKey"/>
        <result column="target_type" property="targetType"/>
        <result column="target_key" property="targetKey"/>
        <result column="relation" property="relation"/>
        <result column="dep_type" property="depType"/>
        <result column="version_constraint" property="versionConstraint"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT edge_id, source_type, source_key, target_type, target_key, relation,
               dep_type, version_constraint, remark, create_time
        FROM dashboard_topology
        ORDER BY edge_id
    </select>

</mapper>
