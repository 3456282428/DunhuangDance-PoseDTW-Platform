<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.AppointmentMapper">
    <resultMap id="BaseResultMap" type="com.art.entity.Appointment">
        <id property="appointmentId" column="appointment_id"/>
        <result property="studentId" column="student_id"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="classId" column="class_id"/>
        <result property="appointmentType" column="appointment_type"/>
        <result property="appointmentTime" column="appointment_time"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <select id="selectById" resultMap="BaseResultMap">SELECT * FROM appointment WHERE appointment_id=#{appointmentId}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="appointmentId">INSERT INTO appointment(student_id,teacher_id,class_id,appointment_type,appointment_time,status,remark) VALUES(#{studentId},#{teacherId},#{classId},#{appointmentType},#{appointmentTime},#{status},#{remark})</insert>
    <update id="update">UPDATE appointment SET appointment_type=#{appointmentType},appointment_time=#{appointmentTime},status=#{status},remark=#{remark} WHERE appointment_id=#{appointmentId}</update>
    <select id="selectByTeacher" resultMap="BaseResultMap">SELECT * FROM appointment <where><if test="teacherId != null"> AND teacher_id=#{teacherId}</if><if test="status != null and status != ''"> AND status=#{status}</if></where> ORDER BY appointment_time DESC</select>
    <select id="selectByStudent" resultMap="BaseResultMap">SELECT * FROM appointment WHERE student_id=#{studentId} ORDER BY appointment_time DESC</select>
</mapper>
