<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.FeedbackMapper">
    <resultMap id="BaseResultMap" type="com.art.entity.Feedback">
        <id property="feedbackId" column="feedback_id"/>
        <result property="studentId" column="student_id"/>
        <result property="content" column="content"/>
        <result property="type" column="type"/>
        <result property="createTime" column="create_time"/>
        <result property="status" column="status"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyTime" column="reply_time"/>
        <result property="replyBy" column="reply_by"/>
        <result property="replyUserId" column="reply_user_id"/>
    </resultMap>
    <select id="selectById" resultMap="BaseResultMap">SELECT * FROM feedback WHERE feedback_id=#{feedbackId}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="feedbackId">INSERT INTO feedback(student_id,content,type,create_time,status,reply_content,reply_time,reply_by,reply_user_id) VALUES(#{studentId},#{content},#{type},#{createTime},#{status},#{replyContent},#{replyTime},#{replyBy},#{replyUserId})</insert>
    <update id="update">UPDATE feedback SET content=#{content},type=#{type},status=#{status},reply_content=#{replyContent},reply_time=#{replyTime},reply_by=#{replyBy},reply_user_id=#{replyUserId} WHERE feedback_id=#{feedbackId}</update>
    <select id="selectByStudentId" resultMap="BaseResultMap">SELECT * FROM feedback WHERE student_id=#{studentId} ORDER BY create_time DESC</select>
    <select id="selectByCondition" resultMap="BaseResultMap">SELECT * FROM feedback <where><if test="studentId != null"> AND student_id=#{studentId}</if><if test="status != null and status != ''"> AND status=#{status}</if></where> ORDER BY create_time DESC</select>
    <select id="selectAll" resultMap="BaseResultMap">SELECT * FROM feedback ORDER BY create_time DESC</select>
</mapper>
