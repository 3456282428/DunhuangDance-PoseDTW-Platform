<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.HomeworkMapper">
    <resultMap id="BaseResultMap" type="com.art.entity.Homework">
        <id property="homeworkId" column="homework_id"/>
        <result property="classId" column="class_id"/>
        <result property="scheduleId" column="schedule_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
        <result property="deadline" column="deadline"/>
        <result property="refVideoUrl" column="ref_video_url"/>
        <result property="refVideoName" column="ref_video_name"/>
    </resultMap>

    <resultMap id="StudentHomeworkResultMap" type="com.art.vo.StudentHomeworkVO">
        <result property="homeworkId" column="homework_id"/>
        <result property="classId" column="class_id"/>
        <result property="className" column="class_name"/>
        <result property="scheduleId" column="schedule_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="refVideoUrl" column="ref_video_url"/>
        <result property="refVideoName" column="ref_video_name"/>
        <result property="createTime" column="create_time"/>
        <result property="submissionId" column="submission_id"/>
        <result property="submitContent" column="submit_content"/>
        <result property="attachmentUrl" column="attachment_url"/>
        <result property="attachmentName" column="attachment_name"/>
        <result property="submitTime" column="submit_time"/>
        <result property="score" column="score"/>
        <result property="teacherComment" column="teacher_comment"/>
        <result property="aiScore" column="ai_score"/>
        <result property="aiReport" column="ai_report"/>
        <result property="aiStatus" column="ai_status"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">SELECT * FROM homework WHERE homework_id=#{homeworkId}</select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="homeworkId">
        INSERT INTO homework(class_id, schedule_id, title, content, create_time, deadline, ref_video_url, ref_video_name)
        VALUES(#{classId}, #{scheduleId}, #{title}, #{content}, COALESCE(#{createTime}, NOW()), #{deadline}, #{refVideoUrl}, #{refVideoName})
    </insert>

    <update id="update">
        UPDATE homework SET class_id=#{classId}, schedule_id=#{scheduleId}, title=#{title}, content=#{content}
        WHERE homework_id=#{homeworkId}
    </update>

    <delete id="deleteById">DELETE FROM homework WHERE homework_id=#{homeworkId}</delete>

    <select id="selectByClassId" resultMap="BaseResultMap">SELECT * FROM homework WHERE class_id=#{classId} ORDER BY create_time DESC</select>

    <select id="selectByConditions" resultMap="BaseResultMap">
        SELECT * FROM homework
        <where>
            <if test="classId != null"> AND class_id=#{classId}</if>
            <if test="scheduleId != null"> AND schedule_id=#{scheduleId}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectStudentHomeworks" resultMap="StudentHomeworkResultMap">
        SELECT h.homework_id, h.class_id, c.class_name, h.schedule_id, h.title, h.content, h.create_time,
               h.ref_video_url, h.ref_video_name,
               s.submission_id, s.content AS submit_content, s.attachment_url, s.attachment_name,
               s.submit_time, s.score, s.teacher_comment, s.ai_score, s.ai_report, s.ai_status,
               COALESCE(s.status, '未提交') AS status
        FROM homework h
        JOIN course_class c ON c.class_id = h.class_id
        JOIN enrollment e ON e.class_id = h.class_id AND e.student_id = #{studentId}
        LEFT JOIN homework_submission s ON s.homework_id = h.homework_id AND s.student_id = #{studentId}
        ORDER BY h.create_time DESC
    </select>

    <select id="countByClassId" resultType="int">SELECT COUNT(*) FROM homework WHERE class_id=#{classId}</select>
</mapper>
