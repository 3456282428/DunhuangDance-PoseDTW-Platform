<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.art.mapper.VisitorBookingMapper">

    <resultMap id="BaseResultMap" type="com.art.entity.VisitorBooking">
        <id property="bookingId" column="booking_id"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="classId" column="class_id"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="preferredTime" column="preferred_time"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM visitor_booking WHERE booking_id = #{bookingId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="bookingId">
        INSERT INTO visitor_booking (name, phone, class_id, teacher_id,
                                     preferred_time, remark, status, create_time)
        VALUES (#{name}, #{phone}, #{classId}, #{teacherId},
                #{preferredTime}, #{remark}, #{status}, #{createTime})
    </insert>

    <update id="updateStatus">
        UPDATE visitor_booking SET status = #{status} WHERE booking_id = #{bookingId}
    </update>

    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT * FROM visitor_booking WHERE phone = #{phone}
        ORDER BY create_time DESC
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT * FROM visitor_booking
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>
